# ─── LLM API ─────────────────────────────────────────
# 支持 OpenAI / Azure OpenAI / 自建 API
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://codeproxy.dev/v1
# 首轮 Vision 模型（需多模态能力）
LLM_VISION_MODEL=gpt-5.2
# 多轮微调 Text-only 模型（速度快、成本低）
LLM_TEXT_MODEL=gpt-5.2
# 视觉图片输入模式：auto / data_url / public_url
LLM_VISION_INPUT_MODE=auto
# 单次输出上限（过大会显著拖慢首轮）
LLM_MAX_OUTPUT_TOKENS=2048
# 主路径（stream chat.completions）超时与重试
LLM_PRIMARY_TIMEOUT_MS=120000
LLM_PRIMARY_RETRY_COUNT=1
# 备用路径（responses）超时
LLM_FALLBACK_TIMEOUT_MS=90000

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# Session TTL（秒），默认 30 分钟
SESSION_TTL=1800
# /api/analyze 允许上传的单文件上限（MB）
ANALYZE_MAX_FILE_SIZE_MB=50
# 临时视觉预览图有效期（秒）
VISION_PREVIEW_TTL_SECONDS=900
# XMP 文件有效期（秒），默认 24 小时
XMP_FILE_TTL_SECONDS=86400
# 基础速率限制（单 IP / 窗口）
ANALYZE_RATE_LIMIT_MAX=12
ANALYZE_RATE_LIMIT_WINDOW_SECONDS=300
REFINE_RATE_LIMIT_MAX=40
REFINE_RATE_LIMIT_WINDOW_SECONDS=300
XMP_RATE_LIMIT_MAX=60
XMP_RATE_LIMIT_WINDOW_SECONDS=300

# ─── OSS / 文件存储 ─────────────────────────────────
# MVP 阶段先用本地 /tmp + 静态文件服务，后续切 OSS
XMP_STORAGE_MODE=local
# XMP_STORAGE_MODE=oss
# OSS_ACCESS_KEY_ID=your-key
# OSS_ACCESS_KEY_SECRET=your-secret
# OSS_BUCKET=lumina-xmp
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ─── Server ──────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
# 当视觉 provider 只接受公网图片 URL 时，填写后端公网基础地址
# 例如 https://api.lumina.example.com
PUBLIC_API_BASE_URL=
# 逗号分隔，支持通配符；默认允许 localhost/127.0.0.1 任意端口
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
