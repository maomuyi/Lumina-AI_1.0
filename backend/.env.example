# ─── LLM API ─────────────────────────────────────────
# Text-only：后续 Chat / 自然语言微调，不传图。DeepSeek key 粘贴在这里。
TEXT_API_KEY=your-deepseek-api-key-here
TEXT_BASE_URL=https://api.deepseek.com
TEXT_MODEL=deepseek-v4-flash

# Vision：首轮完整诊断会传图，必须使用支持多模态识图的服务。
# 暂时没有多模态 key 时保持为空，首轮会自动降级到本地规则分析。
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-5-2025-08-07

# 旧版 OPENAI_* 已废弃；不要再把文本和识图共用同一个 key。
# 单次输出上限（过大会显著拖慢首轮）
LLM_MAX_OUTPUT_TOKENS=2048
# 主路径（stream chat.completions）超时与重试
LLM_PRIMARY_TIMEOUT_MS=120000
LLM_PRIMARY_RETRY_COUNT=1
# 备用路径（responses）超时
LLM_FALLBACK_TIMEOUT_MS=90000

# ─── Style Web Search（可选，仅 Chat / 微调风格意图触发）──────────────
STYLE_WEB_SEARCH_ENABLED=false
STYLE_SEARCH_PROVIDER=duckduckgo
STYLE_SEARCH_API_KEY=
STYLE_SEARCH_CACHE_TTL_SECONDS=604800
STYLE_SEARCH_MAX_RESULTS=5
STYLE_SEARCH_TIMEOUT_MS=8000

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
# Session TTL（秒），默认 30 分钟
SESSION_TTL=1800
# /api/analyze 允许上传的单文件上限（MB）
ANALYZE_MAX_FILE_SIZE_MB=50
# XMP 文件有效期（秒），默认 24 小时
XMP_FILE_TTL_SECONDS=86400

# ─── OSS / 文件存储 ─────────────────────────────────
# MVP 阶段先用本地 /tmp + 静态文件服务，后续切 OSS
XMP_STORAGE_MODE=local
# XMP_STORAGE_MODE=oss
# OSS_ACCESS_KEY_ID=your-key
# OSS_ACCESS_KEY_SECRET=your-secret
# OSS_BUCKET=lumina-xmp
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ─── Server ──────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
# 逗号分隔，支持通配符；默认允许 localhost/127.0.0.1 任意端口
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://*.trycloudflare.com
