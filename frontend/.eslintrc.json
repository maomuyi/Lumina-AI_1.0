{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "wasm/build_*/",
    "wasm/build_release/",
    "wasm/build_debug/",
    "public/wasm/",
    "tsconfig.tsbuildinfo"
  ]
}
